# Supabase — Project settings → API. Both are public values that ship to the browser;
# the service-role key is NOT one of them and must never appear in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# The public origin of this deployment, no trailing slash. Used for metadataBase, the
# sitemap and robots.txt. On Vercel it is inferred and can be left out; locally it
# defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://zevern.example

# Which clock the server keeps. "Today" — tasks due today, overdue counts, the revenue
# month — is decided server-side, and a host in UTC gets the date wrong for the first
# two hours of every Belgrade morning. Defaults to Europe/Belgrade.
# APP_TIMEZONE=Europe/Belgrade

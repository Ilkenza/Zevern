# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# A build cache moved out of the way to force a rebuild — 700MB of Turbopack
# sst files, two of them over GitHub's 100MB limit. Never committable, never wanted.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values — only the names and why they exist.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# what the desktop app drops into the repo folder while we work — screenshots,
# .tgz transfers, one-off demo pages. None of it is source.
/Claude outputs/

# archives, wherever they land. This is the shape of the thing that breaks a push:
# one 100MB+ file and GitHub refuses the whole repository.
*.tgz
*.tar.gz
*.zip

# tool caches that appear only on the machine that ran the tool
.eslintcache
.stylelintcache
/supabase/.temp/
/supabase/.branches/
.netlify/

# os junk
Thumbs.db

# Scratch that the remote bridge cannot delete
_to_delete/
